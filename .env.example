# Copy this file to .env and adjust values. .env is git-ignored: never commit secrets.
# On a hosting (Render, a cloud server…) set the same variables in its settings instead.

# HTTP server. Locally 127.0.0.1 (this computer only); on a server 0.0.0.0 (the Dockerfile sets it).
PORT=3000
HOST=127.0.0.1

# Password to use the app, shared with colleagues. Empty = no login (fine on your own computer only).
APP_PASSWORD=

# Optional: signs the login cookie. If empty it is derived from APP_PASSWORD
# (changing the password then logs everyone out). Any long random string.
SESSION_SECRET=

# Refuse to scan internal-network addresses (localhost, 10.x, 192.168.x…). Must be true on a public
# server; false locally so you can scan sites running on your computer. The Dockerfile sets true.
BLOCK_PRIVATE_TARGETS=false

# true behind a proxy (Render, a load balancer), to see the visitors' real IP. The Dockerfile sets true.
TRUST_PROXY=false
